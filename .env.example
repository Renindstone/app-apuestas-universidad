# Copiar a .env (no se sube a git). Valores de desarrollo.
POSTGRES_USER=apuestas
POSTGRES_PASSWORD=apuestas_dev
# Mínimo 32 caracteres. El mismo valor en ms-usuarios y api-gateway.
JWT_SECRET=cambia-esta-clave-por-una-de-32-o-mas-caracteres
ADMIN_PASSWORD=cambia-esta-clave
# Opcional: tope de memoria de cada JVM en el docker-compose completo.
JAVA_OPCIONES=-Xmx384m
