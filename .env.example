# Copiar a .env (no se sube a git). Valores de desarrollo.
POSTGRES_USER=apuestas
POSTGRES_PASSWORD=apuestas_dev
# Mínimo 32 caracteres. El mismo valor en ms-usuarios y api-gateway.
JWT_SECRET=cambia-esta-clave-por-una-de-32-o-mas-caracteres
ADMIN_PASSWORD=cambia-esta-clave
# Opcional: tope de memoria de cada JVM en el docker-compose completo.
JAVA_OPCIONES=-Xmx384m

# Para una, dos o tres máquinas no hace falta escribir nada más: iniciar.cmd (Windows) o ./iniciar.sh (Mac y Linux)
# detectan la red y agregan solas al final IP_ESTA_MAQUINA, IP_EUREKA, IP_POSTGRES, IP_GATEWAY e IP_WEB (guía: infra/DISTRIBUIDO.md).
# También guardan CODIGO_EQUIPO: lo genera el núcleo y las otras máquinas lo piden una vez. Firma las órdenes del panel entre máquinas.
