digraph G {
graph [rankdir=TB, fontname="Liberation Sans", fontsize=12, nodesep=0.25, ranksep=0.28, pad=0.15, newrank=true, splines=spline];
node [fontname="Liberation Sans", fontsize=11, penwidth=1.3, margin="0.12,0.06"];
edge [fontname="Liberation Sans", fontsize=10, color="#404040", arrowsize=0.7, penwidth=1.2];
l0 [shape=box, style="rounded,filled", fillcolor="#404040", color="#404040", fontcolor="white", margin="0.16,0.06", label=<06:00 (@Scheduled) o<BR/>POST /interno/liquidar>];
l1 [shape=box, style=filled, fillcolor="#EAF2FB", color="#4F81BD", label=<Toma los picks y las<BR/>apuestas pendientes>];
f_in [shape=circle, width=0.32, fixedsize=true, style=filled, fillcolor="#FFFFFF", color="#404040", fontsize=11, label=<<B>F</B>>];
l2 [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#4F81BD" BGCOLOR="#EAF2FB"><TR><TD WIDTH="7"></TD><TD><B>ms-catalogo</B><BR/><FONT POINT-SIZE="9" FACE="Liberation Mono">GET /partidos/{id}</FONT><BR/>Resultado del partido</TD><TD WIDTH="7"></TD></TR></TABLE>>];
l3 [shape=diamond, style=filled, fillcolor="#FFFFFF", color="#404040", margin="0.02,0.02", fontsize=10, label=<¿FINALIZADO?>];
l4 [shape=diamond, style=filled, fillcolor="#FFFFFF", color="#404040", margin="0.02,0.02", fontsize=10, label=<¿Mercado<BR/>TARJETAS o<BR/>CORNERS?>];
l5 [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#4F81BD" BGCOLOR="#EAF2FB"><TR><TD WIDTH="7"></TD><TD><B>ms-estadisticas</B><BR/><FONT POINT-SIZE="9" FACE="Liberation Mono">GET /partidos/{id}/estadisticas</FONT><BR/>Estadísticas finales</TD><TD WIDTH="7"></TD></TR></TABLE>>];
l6 [shape=diamond, style=filled, fillcolor="#FFFFFF", color="#404040", margin="0.02,0.02", fontsize=10, label=<¿Hay<BR/>estadísticas?>];
lp [shape=box, style=filled, fillcolor="#EAF2FB", color="#4F81BD", label=<Sigue pendiente<BR/>(se reintenta<BR/>mañana)>];
k1 [shape=circle, width=0.32, fixedsize=true, style=filled, fillcolor="#FFFFFF", color="#404040", fontsize=11, label=<<B>K</B>>];
k2 [shape=circle, width=0.32, fixedsize=true, style=filled, fillcolor="#FFFFFF", color="#404040", fontsize=11, label=<<B>K</B>>];
l0 -> l1;
l1 -> l2;
f_in -> l2;
{rank=same; l2; f_in;}
l2 -> l3;
l3 -> lp [label=<No>];
l3 -> l4 [label=<Sí>];
l4 -> l5 [label=<Sí>];
l5 -> l6;
l6 -> lp [label=<No>];
l6 -> k1 [label=<Sí>];
l4 -> k2 [label=<No>];
j1 [shape=circle, width=0.32, fixedsize=true, style=filled, fillcolor="#FFFFFF", color="#404040", fontsize=11, label=<<B>J</B>>];
lp -> j1;
k_in [shape=circle, width=0.32, fixedsize=true, style=filled, fillcolor="#FFFFFF", color="#404040", fontsize=11, label=<<B>K</B>>];
l7 [shape=box, style=filled, fillcolor="#EAF2FB", color="#4F81BD", label=<Compara el resultado<BR/>con la selección<BR/>y la línea (.5)>];
l8 [shape=diamond, style=filled, fillcolor="#FFFFFF", color="#404040", margin="0.02,0.02", fontsize=10, label=<¿Gana?>];
l9 [shape=box, style=filled, fillcolor="#EAF2FB", color="#4F81BD", label=<GANADA: monto<BR/>× (cuota − 1)>];
l10 [shape=box, style=filled, fillcolor="#EAF2FB", color="#4F81BD", label=<PERDIDA:<BR/>− monto>];
l11 [shape=box, style=filled, fillcolor="#EAF2FB", color="#4F81BD", label=<Guarda el resultado<BR/>y la ganancia>];
j_in [shape=circle, width=0.32, fixedsize=true, style=filled, fillcolor="#FFFFFF", color="#404040", fontsize=11, label=<<B>J</B>>];
l12 [shape=diamond, style=filled, fillcolor="#FFFFFF", color="#404040", margin="0.02,0.02", fontsize=10, label=<¿Quedan<BR/>pendientes?>];
f1 [shape=circle, width=0.32, fixedsize=true, style=filled, fillcolor="#FFFFFF", color="#404040", fontsize=11, label=<<B>F</B>>];
l13 [shape=box, style="rounded,filled", fillcolor="#F2F2F2", color="#7F7F7F", margin="0.16,0.06", label=<Fin>];
k_in -> l7;
l7 -> l8;
l8 -> l9 [label=<Sí>];
l8 -> l10 [label=<No>];
l9 -> l11;
l10 -> l11;
l11 -> l12;
j_in -> l12;
{rank=same; l12; j_in;}
l12 -> f1 [label=<Sí>];
l12 -> l13 [label=<No>];
{rank=same; l0; k_in;}
}