digraph G {
graph [rankdir=TB, fontname="Liberation Sans", fontsize=12, nodesep=0.25, ranksep=0.28, pad=0.15, newrank=true, splines=spline];
node [fontname="Liberation Sans", fontsize=11, penwidth=1.3, margin="0.12,0.06"];
edge [fontname="Liberation Sans", fontsize=10, color="#404040", arrowsize=0.7, penwidth=1.2];
subgraph cluster_eva { label=<<B>Evaluar una cuota</B>>; labeljust=l; style="rounded,dashed"; color="#8EA9DB"; fontsize=12; margin=10;
v0 [shape=box, style="rounded,filled", fillcolor="#404040", color="#404040", fontcolor="white", margin="0.16,0.06", label=<POST /evaluaciones>];
v1 [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#4F81BD" BGCOLOR="#EAF2FB"><TR><TD WIDTH="7"></TD><TD><B>ms-predicciones</B><BR/>Probabilidad del<BR/>mercado elegido</TD><TD WIDTH="7"></TD></TR></TABLE>>];
v2 [shape=box, style=filled, fillcolor="#EAF2FB", color="#4F81BD", label=<EV = p × cuota − 1<BR/>f = EV / (cuota − 1)<BR/>stake = min(0.25 f, 3 %)<BR/>(0 si EV ≤ 0)>];
v3 [shape=diamond, style=filled, fillcolor="#FFFFFF", color="#404040", margin="0.02,0.02", fontsize=10, label=<¿EV ≥ 0.03?>];
v4 [shape=box, style=filled, fillcolor="#EAF2FB", color="#4F81BD", label=<CON_VALOR>];
v5 [shape=diamond, style=filled, fillcolor="#FFFFFF", color="#404040", margin="0.02,0.02", fontsize=10, label=<¿EV &gt; 0?>];
v6 [shape=box, style=filled, fillcolor="#EAF2FB", color="#4F81BD", label=<MARGINAL>];
v7 [shape=box, style=filled, fillcolor="#EAF2FB", color="#4F81BD", label=<SIN_VALOR>];
v8 [shape=box, style="rounded,filled", fillcolor="#F2F2F2", color="#7F7F7F", margin="0.16,0.06", label=<200 con el<BR/>veredicto>];
v0 -> v1;
v1 -> v2;
v2 -> v3;
v3 -> v4 [label=<Sí>];
v3 -> v5 [label=<No>];
v5 -> v6 [label=<Sí>];
v5 -> v7 [label=<No>];
v4 -> v8;
v6 -> v8;
v7 -> v8;
}
subgraph cluster_reg { label=<<B>Registrar una apuesta</B>>; labeljust=l; style="rounded,dashed"; color="#8EA9DB"; fontsize=12; margin=10;
m0 [shape=box, style="rounded,filled", fillcolor="#404040", color="#404040", fontcolor="white", margin="0.16,0.06", label=<POST /mis-apuestas>];
m1 [shape=box, style=filled, fillcolor="#EAF2FB", color="#4F81BD", label=<Lee X-Usuario-Id>];
m2 [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#4F81BD" BGCOLOR="#EAF2FB"><TR><TD WIDTH="7"></TD><TD><B>ms-catalogo</B><BR/><FONT POINT-SIZE="9" FACE="Liberation Mono">GET /partidos/{id}</FONT><BR/>Descripción<BR/>«Local vs Visitante»</TD><TD WIDTH="7"></TD></TR></TABLE>>];
m3 [shape=box, style=filled, fillcolor="#EAF2FB", color="#4F81BD", label=<Guarda la apuesta<BR/>(pendiente)>];
mdb [shape=cylinder, style=filled, fillcolor="#F2F2F2", color="#7F7F7F", fontsize=10, label=<apuestas_db>];
m4 [shape=box, style="rounded,filled", fillcolor="#F2F2F2", color="#7F7F7F", margin="0.16,0.06", label=<201 con<BR/>la apuesta>];
m0 -> m1;
m1 -> m2;
m2 -> m3;
m3 -> mdb [style="dashed"];
m3 -> m4;
}
subgraph cluster_ren { label=<<B>Rendimiento</B>>; labeljust=l; style="rounded,dashed"; color="#8EA9DB"; fontsize=12; margin=10;
r0 [shape=box, style="rounded,filled", fillcolor="#404040", color="#404040", fontcolor="white", margin="0.16,0.06", label=<GET /mis-apuestas/<BR/>rendimiento>];
r1 [shape=box, style=filled, fillcolor="#EAF2FB", color="#4F81BD", label=<Filtra las apuestas<BR/>del usuario del token<BR/>ya liquidadas>];
r2 [shape=box, style=filled, fillcolor="#EAF2FB", color="#4F81BD", label=<Suma ganadas, perdidas,<BR/>monto y beneficio;<BR/>ROI = beneficio / monto>];
r3 [shape=box, style="rounded,filled", fillcolor="#F2F2F2", color="#7F7F7F", margin="0.16,0.06", label=<200 rendimiento<BR/>y ROI por mercado>];
r0 -> r1;
r1 -> r2;
r2 -> r3;
}
{rank=same; v0; m0; r0;}
}