digraph G {
graph [rankdir=TB, fontname="Liberation Sans", fontsize=12, nodesep=0.3, ranksep=0.32, pad=0.15, newrank=true, splines=spline];
node [fontname="Liberation Sans", fontsize=11, penwidth=1.3, margin="0.12,0.06"];
edge [fontname="Liberation Sans", fontsize=10, color="#404040", arrowsize=0.7, penwidth=1.2];
ini [shape=box, style="rounded,filled", fillcolor="#404040", color="#404040", fontcolor="white", margin="0.16,0.06", label=<Inicio: llega<BR/>/api/&lt;servicio&gt;/**>];
p1 [shape=box, style=filled, fillcolor="#E2EFDA", color="#548235", label=<Quita X-Usuario-Id y<BR/>X-Usuario-Rol que<BR/>mande el cliente>];
q1 [shape=diamond, style=filled, fillcolor="#FFFFFF", color="#404040", margin="0.02,0.02", fontsize=10, label=<¿La ruta<BR/>contiene<BR/>/interno/?>];
f1 [shape=box, style="rounded,filled", fillcolor="#FBE4E4", color="#C0504D", margin="0.16,0.06", label=<403>];
q2 [shape=diamond, style=filled, fillcolor="#FFFFFF", color="#404040", margin="0.02,0.02", fontsize=10, label=<¿Ruta<BR/>pública? (1)>];
n1 [shape=note, style=filled, fillcolor="#FAFAFA", color="#9E9E9E", fontsize=9, margin="0.08,0.04", label=<(1) POST /api/usuarios/auth/**,<BR/>GET /api/catalogo/**,<BR/>/actuator/health y Swagger>];
q2 -> n1 [style=dotted, arrowhead=none, color="#9E9E9E", constraint=false];
q3 [shape=diamond, style=filled, fillcolor="#FFFFFF", color="#404040", margin="0.02,0.02", fontsize=10, label=<¿Token Bearer<BR/>bien firmado<BR/>y vigente?>];
f2 [shape=box, style="rounded,filled", fillcolor="#FBE4E4", color="#C0504D", margin="0.16,0.06", label=<401<BR/>NO_AUTORIZADO>];
q4 [shape=diamond, style=filled, fillcolor="#FFFFFF", color="#404040", margin="0.02,0.02", fontsize=10, label=<¿/api/ingesta/**<BR/>y rol distinto<BR/>de ADMIN?>];
f3 [shape=box, style="rounded,filled", fillcolor="#FBE4E4", color="#C0504D", margin="0.16,0.06", label=<403>];
p2 [shape=box, style=filled, fillcolor="#E2EFDA", color="#548235", label=<Añade X-Usuario-Id (sub)<BR/>y X-Usuario-Rol (rol)>];
a1 [shape=circle, width=0.32, fixedsize=true, style=filled, fillcolor="#FFFFFF", color="#404040", fontsize=11, label=<<B>A</B>>];
a2 [shape=circle, width=0.32, fixedsize=true, style=filled, fillcolor="#FFFFFF", color="#404040", fontsize=11, label=<<B>A</B>>];
a_in [shape=circle, width=0.32, fixedsize=true, style=filled, fillcolor="#FFFFFF", color="#404040", fontsize=11, label=<<B>A</B>>];
p3 [shape=box, style=filled, fillcolor="#E2EFDA", color="#548235", label=<Quita /api/&lt;servicio&gt;<BR/>(StripPrefix=2)>];
p4 [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#548235" BGCOLOR="#E2EFDA"><TR><TD WIDTH="7"></TD><TD><B>discovery-server</B><BR/>Instancia de<BR/>lb://&lt;servicio&gt;</TD><TD WIDTH="7"></TD></TR></TABLE>>];
p5 [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#595959" BGCOLOR="#FFFFFF"><TR><TD WIDTH="7"></TD><TD><B>microservicio destino</B><BR/>Atiende la petición</TD><TD WIDTH="7"></TD></TR></TABLE>>];
fin [shape=box, style="rounded,filled", fillcolor="#F2F2F2", color="#7F7F7F", margin="0.16,0.06", label=<Devuelve la respuesta<BR/>(CORS para :8090)>];
ini -> p1;
p1 -> q1;
q1 -> f1 [label=<Sí>];
q1 -> q2 [label=<No>];
q2 -> a1 [label=<Sí>];
q2 -> q3 [label=<No>];
q3 -> f2 [label=<No>];
q3 -> q4 [label=<Sí>];
q4 -> f3 [label=<Sí>];
q4 -> p2 [label=<No>];
p2 -> a2;
a_in -> p3;
p3 -> p4;
p4 -> p5;
p5 -> fin;
}