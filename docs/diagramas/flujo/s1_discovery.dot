digraph G {
graph [rankdir=TB, fontname="Liberation Sans", fontsize=12, nodesep=0.3, ranksep=0.32, pad=0.15, newrank=true, splines=spline];
node [fontname="Liberation Sans", fontsize=11, penwidth=1.3, margin="0.12,0.06"];
edge [fontname="Liberation Sans", fontsize=10, color="#404040", arrowsize=0.7, penwidth=1.2];
ini [shape=box, style="rounded,filled", fillcolor="#404040", color="#404040", fontcolor="white", margin="0.16,0.06", label=<Inicio: arranca<BR/>el contenedor>];
p1 [shape=box, style=filled, fillcolor="#E2EFDA", color="#548235", label=<Levanta Eureka en :8761<BR/>(no se registra a sí mismo)>];
a_in [shape=circle, width=0.32, fixedsize=true, style=filled, fillcolor="#FFFFFF", color="#404040", fontsize=11, label=<<B>A</B>>];
p2 [shape=box, style=filled, fillcolor="#E2EFDA", color="#548235", label=<Espera un evento>];
q [shape=diamond, style=filled, fillcolor="#FFFFFF", color="#404040", margin="0.02,0.02", fontsize=10, label=<¿Qué<BR/>ocurre?>];
r1 [shape=box, style=filled, fillcolor="#E2EFDA", color="#548235", label=<Guarda nombre,<BR/>IP y puerto<BR/>(estado UP)>];
r2 [shape=box, style=filled, fillcolor="#E2EFDA", color="#548235", label=<Renueva<BR/>el registro>];
r3 [shape=box, style=filled, fillcolor="#E2EFDA", color="#548235", label=<Devuelve las<BR/>instancias UP>];
r4 [shape=box, style=filled, fillcolor="#E2EFDA", color="#548235", label=<Lo retira<BR/>del registro>];
r5 [shape=box, style=filled, fillcolor="#E2EFDA", color="#548235", label=<Muestra los<BR/>servicios y<BR/>su estado>];
a1 [shape=circle, width=0.32, fixedsize=true, style=filled, fillcolor="#FFFFFF", color="#404040", fontsize=11, label=<<B>A</B>>];
a2 [shape=circle, width=0.32, fixedsize=true, style=filled, fillcolor="#FFFFFF", color="#404040", fontsize=11, label=<<B>A</B>>];
a3 [shape=circle, width=0.32, fixedsize=true, style=filled, fillcolor="#FFFFFF", color="#404040", fontsize=11, label=<<B>A</B>>];
a4 [shape=circle, width=0.32, fixedsize=true, style=filled, fillcolor="#FFFFFF", color="#404040", fontsize=11, label=<<B>A</B>>];
a5 [shape=circle, width=0.32, fixedsize=true, style=filled, fillcolor="#FFFFFF", color="#404040", fontsize=11, label=<<B>A</B>>];
ini -> p1;
p1 -> p2;
p2 -> a_in [dir="back"];
{rank=same; p2; a_in;}
p2 -> q;
q -> r1 [label=<Registro>];
q -> r2 [label=<Latido<BR/>(30 s)>];
q -> r3 [label=<Búsqueda<BR/>lb://&lt;nombre&gt;>];
q -> r4 [label=<Sin latido<BR/>(90 s)>];
q -> r5 [label=<Panel<BR/>:8761>];
r1 -> a1;
r2 -> a2;
r3 -> a3;
r4 -> a4;
r5 -> a5;
}