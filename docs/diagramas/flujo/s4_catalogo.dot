digraph G {
graph [rankdir=TB, fontname="Liberation Sans", fontsize=12, nodesep=0.25, ranksep=0.32, pad=0.15, newrank=true, splines=spline];
node [fontname="Liberation Sans", fontsize=11, penwidth=1.3, margin="0.12,0.06"];
edge [fontname="Liberation Sans", fontsize=10, color="#404040", arrowsize=0.7, penwidth=1.2];
subgraph cluster_ups { label=<<B>Upsert interno</B>>; labeljust=l; style="rounded,dashed"; color="#8EA9DB"; fontsize=12; margin=10;
u0 [shape=box, style="rounded,filled", fillcolor="#404040", color="#404040", fontcolor="white", margin="0.16,0.06", label=<POST /interno/partidos<BR/>(desde ms-ingesta)>];
u1 [shape=box, style=filled, fillcolor="#EAF2FB", color="#4F81BD", label=<Busca la liga por código;<BR/>busca o crea los equipos<BR/>y el árbitro>];
u2 [shape=diamond, style=filled, fillcolor="#FFFFFF", color="#404040", margin="0.02,0.02", fontsize=10, label=<¿Existe el cruce<BR/>(local, visitante,<BR/>temporada)?>];
u3 [shape=box, style=filled, fillcolor="#EAF2FB", color="#4F81BD", label=<Actualiza fecha,<BR/>árbitro y goles>];
u4 [shape=box, style=filled, fillcolor="#EAF2FB", color="#4F81BD", label=<Crea el partido<BR/>(PROGRAMADO)>];
u5 [shape=diamond, style=filled, fillcolor="#FFFFFF", color="#404040", margin="0.02,0.02", fontsize=10, label=<¿Llegaron<BR/>goles?>];
u6 [shape=box, style=filled, fillcolor="#EAF2FB", color="#4F81BD", label=<Estado =<BR/>FINALIZADO>];
u7 [shape=box, style=filled, fillcolor="#EAF2FB", color="#4F81BD", label=<Mantiene el estado<BR/>(un FINALIZADO no<BR/>vuelve a PROGRAMADO)>];
udb [shape=cylinder, style=filled, fillcolor="#F2F2F2", color="#7F7F7F", fontsize=10, label=<catalogo_db>];
u8 [shape=box, style="rounded,filled", fillcolor="#F2F2F2", color="#7F7F7F", margin="0.16,0.06", label=<200 PartidoDTO<BR/>con los IDs>];
u0 -> u1;
u1 -> u2;
u2 -> u3 [label=<Sí>];
u2 -> u4 [label=<No>];
u3 -> u5;
u4 -> u5;
u5 -> u6 [label=<Sí>];
u5 -> u7 [label=<No>];
u6 -> u8;
u7 -> u8;
u6 -> udb [style="dashed"];
u7 -> udb [style="dashed"];
}
subgraph cluster_con { label=<<B>Consulta de partidos</B>>; labeljust=l; style="rounded,dashed"; color="#8EA9DB"; fontsize=12; margin=10;
c0 [shape=box, style="rounded,filled", fillcolor="#404040", color="#404040", fontcolor="white", margin="0.16,0.06", label=<GET /partidos?fecha<BR/>&amp;ligaId&amp;estado>];
c1 [shape=diamond, style=filled, fillcolor="#FFFFFF", color="#404040", margin="0.02,0.02", fontsize=10, label=<¿Viene<BR/>fecha?>];
c2 [shape=box, style=filled, fillcolor="#EAF2FB", color="#4F81BD", label=<Convierte el día de<BR/>Lima a rango UTC<BR/>(05:00 a 05:00)>];
c3 [shape=box, style=filled, fillcolor="#EAF2FB", color="#4F81BD", label=<Aplica los filtros<BR/>de liga y estado<BR/>(todos opcionales)>];
c4 [shape=box, style=filled, fillcolor="#EAF2FB", color="#4F81BD", label=<Ordena por<BR/>fechaHora>];
c5 [shape=box, style="rounded,filled", fillcolor="#F2F2F2", color="#7F7F7F", margin="0.16,0.06", label=<200 lista de<BR/>PartidoDTO>];
c0 -> c1;
c1 -> c2 [label=<Sí>];
c2 -> c3;
c1 -> c3 [label=<No>];
c3 -> c4;
c4 -> c5;
}
subgraph cluster_arr { label=<<B>Ligas iniciales</B>>; labeljust=l; style="rounded,dashed"; color="#8EA9DB"; fontsize=12; margin=10;
k0 [shape=box, style="rounded,filled", fillcolor="#404040", color="#404040", fontcolor="white", margin="0.16,0.06", label=<Arranque>];
k1 [shape=diamond, style=filled, fillcolor="#FFFFFF", color="#404040", margin="0.02,0.02", fontsize=10, label=<¿Tabla liga<BR/>vacía?>];
k2 [shape=box, style=filled, fillcolor="#EAF2FB", color="#4F81BD", label=<Inserta E0,<BR/>SP1 y D1>];
k3 [shape=box, style="rounded,filled", fillcolor="#F2F2F2", color="#7F7F7F", margin="0.16,0.06", label=<Listo>];
k0 -> k1;
k1 -> k2 [label=<Sí>];
k2 -> k3;
k1 -> k3 [label=<No>];
}
{rank=same; u0; c0; k0;}
}