digraph G {
graph [rankdir=TB, fontname="Liberation Sans", fontsize=12, nodesep=0.22, ranksep=0.28, pad=0.15, newrank=true, splines=spline];
node [fontname="Liberation Sans", fontsize=11, penwidth=1.3, margin="0.12,0.06"];
edge [fontname="Liberation Sans", fontsize=10, color="#404040", arrowsize=0.7, penwidth=1.2];
ini [shape=box, style="rounded,filled", fillcolor="#404040", color="#404040", fontcolor="white", margin="0.16,0.06", label=<Inicio: docker<BR/>compose up>];
eur [shape=box, style=filled, fillcolor="#E2EFDA", color="#548235", label=<<B>discovery-server</B><BR/>Arranca en :8761;<BR/>registra los servicios<BR/>por su nombre>];
gw [shape=box, style=filled, fillcolor="#E2EFDA", color="#548235", label=<<B>api-gateway</B><BR/>Enruta por<BR/>nombre (lb://)>];
esp [shape=box, style=filled, fillcolor="#FFFFFF", color="#595959", label=<Espera la siguiente<BR/>tarea programada<BR/>(hora de Lima)>];
a_in [shape=circle, width=0.32, fixedsize=true, style=filled, fillcolor="#FFFFFF", color="#404040", fontsize=11, label=<<B>A</B>>];
ini -> eur;
eur -> gw;
{rank=same; ini; eur; gw;}
gw -> esp;
esp -> a_in [dir="back"];
{rank=same; esp; a_in;}
cual [shape=diamond, style=filled, fillcolor="#FFFFFF", color="#404040", margin="0.02,0.02", fontsize=10, label=<¿Qué tarea<BR/>toca?>];
esp -> cual;
fd [shape=cylinder, style=filled, fillcolor="#F2F2F2", color="#7F7F7F", fontsize=10, label=<football-data<BR/>.co.uk (CSV)>];
i1 [shape=box, style=filled, fillcolor="#EAF2FB", color="#4F81BD", label=<<B>ms-ingesta</B><BR/>Descarga el CSV<BR/>05:00: temporada actual<BR/>08:00 y 16:00: fixtures>];
i2 [shape=diamond, style=filled, fillcolor="#FFFFFF", color="#404040", margin="0.02,0.02", fontsize=10, label=<¿Descarga<BR/>correcta?>];
i3 [shape=box, style=filled, fillcolor="#EAF2FB", color="#4F81BD", label=<<B>ms-ingesta</B><BR/>Registra la<BR/>ejecución:<BR/>ERROR>];
i4 [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#4F81BD" BGCOLOR="#EAF2FB"><TR><TD WIDTH="7"></TD><TD><B>ms-catalogo</B><BR/>Por cada fila:<BR/>upsert del partido;<BR/>devuelve los IDs</TD><TD WIDTH="7"></TD></TR></TABLE>>];
i6 [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#4F81BD" BGCOLOR="#EAF2FB"><TR><TD WIDTH="7"></TD><TD><B>ms-estadisticas</B><BR/>Guarda estadísticas<BR/>(si la fila trae goles)</TD><TD WIDTH="7"></TD></TR></TABLE>>];
i8 [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#4F81BD" BGCOLOR="#EAF2FB"><TR><TD WIDTH="7"></TD><TD><B>ms-cuotas</B><BR/>Guarda las cuotas<BR/>(si la fila las trae)</TD><TD WIDTH="7"></TD></TR></TABLE>>];
i9 [shape=diamond, style=filled, fillcolor="#FFFFFF", color="#404040", margin="0.02,0.02", fontsize=10, label=<¿Quedan<BR/>filas?>];
i10 [shape=box, style=filled, fillcolor="#EAF2FB", color="#4F81BD", label=<<B>ms-ingesta</B><BR/>Registra la<BR/>ejecución: OK>];
a1 [shape=circle, width=0.32, fixedsize=true, style=filled, fillcolor="#FFFFFF", color="#404040", fontsize=11, label=<<B>A</B>>];
a2 [shape=circle, width=0.32, fixedsize=true, style=filled, fillcolor="#FFFFFF", color="#404040", fontsize=11, label=<<B>A</B>>];
cual -> i1 [label=<05:00, 08:00<BR/>y 16:00>];
fd -> i1 [style="dashed"];
{rank=same; fd; cual;}
i1 -> i2;
i2 -> i3 [label=<No>];
i3 -> a1;
i2 -> i4 [label=<Sí>];
i4 -> i6;
i6 -> i8;
i8 -> i9;
i9 -> i4 [label=<Sí>];
i9 -> i10 [label=<No>];
i10 -> a2;
l1 [shape=box, style=filled, fillcolor="#EAF2FB", color="#4F81BD", label=<<B>ms-apuestas</B><BR/>Toma los picks y<BR/>las apuestas<BR/>pendientes>];
l2 [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#4F81BD" BGCOLOR="#EAF2FB"><TR><TD WIDTH="7"></TD><TD><B>ms-catalogo</B><BR/>Resultado<BR/>del partido</TD><TD WIDTH="7"></TD></TR></TABLE>>];
l3 [shape=diamond, style=filled, fillcolor="#FFFFFF", color="#404040", margin="0.02,0.02", fontsize=10, label=<¿Partido<BR/>FINALIZADO?>];
l5 [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#4F81BD" BGCOLOR="#EAF2FB"><TR><TD WIDTH="7"></TD><TD><B>ms-estadisticas</B><BR/>Tarjetas y córners<BR/>(si el mercado<BR/>los usa)</TD><TD WIDTH="7"></TD></TR></TABLE>>];
l6 [shape=box, style=filled, fillcolor="#EAF2FB", color="#4F81BD", label=<<B>ms-apuestas</B><BR/>Marca GANADA<BR/>o PERDIDA y<BR/>calcula la ganancia>];
a3 [shape=circle, width=0.32, fixedsize=true, style=filled, fillcolor="#FFFFFF", color="#404040", fontsize=11, label=<<B>A</B>>];
cual -> l1 [label=<06:00>];
l1 -> l2;
l2 -> l3;
l3 -> a3 [label=<No: sigue<BR/>pendiente>];
l3 -> l5 [label=<Sí>];
l5 -> l6;
l6 -> a3;
p1 [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#4F81BD" BGCOLOR="#EAF2FB"><TR><TD WIDTH="7"></TD><TD><B>ms-catalogo</B><BR/>Partidos<BR/>PROGRAMADOS<BR/>del día</TD><TD WIDTH="7"></TD></TR></TABLE>>];
p2 [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#4F81BD" BGCOLOR="#EAF2FB"><TR><TD WIDTH="7"></TD><TD><B>ms-predicciones</B><BR/>Por cada partido:<BR/>probabilidad de<BR/>cada mercado</TD><TD WIDTH="7"></TD></TR></TABLE>>];
p3 [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#4F81BD" BGCOLOR="#EAF2FB"><TR><TD WIDTH="7"></TD><TD><B>ms-cuotas</B><BR/>Cuotas de bet365<BR/>y Betano</TD><TD WIDTH="7"></TD></TR></TABLE>>];
p4 [shape=box, style=filled, fillcolor="#EAF2FB", color="#4F81BD", label=<<B>ms-apuestas</B><BR/>EV = p × cuota − 1;<BR/>filtra por umbrales>];
p5 [shape=diamond, style=filled, fillcolor="#FFFFFF", color="#404040", margin="0.02,0.02", fontsize=10, label=<¿Hay<BR/>candidatas?>];
p6 [shape=box, style=filled, fillcolor="#EAF2FB", color="#4F81BD", label=<<B>ms-apuestas</B><BR/>Guarda los picks;<BR/>el de mayor EV es<BR/>la apuesta del día>];
a4 [shape=circle, width=0.32, fixedsize=true, style=filled, fillcolor="#FFFFFF", color="#404040", fontsize=11, label=<<B>A</B>>];
cual -> p1 [label=<09:00>];
p1 -> p2;
p2 -> p3;
p3 -> p4;
p4 -> p5;
p5 -> p6 [label=<Sí>];
p5 -> a4 [label=<No: hoy no hay<BR/>apuesta del día>];
p6 -> a4;
}